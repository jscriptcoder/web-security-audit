# Copy to .env for local development. Production values come from the secret manager.
DATABASE_URL=postgres://notes:change-me@localhost:5432/notes?sslmode=disable
DATA_DIR=/var/lib/notes
JWT_ISSUER=https://auth.example.com
JWT_AUDIENCE=notes-api
JWKS_URL=https://auth.example.com/.well-known/jwks.json
WEB_ORIGIN=https://notes.example.com
WEBHOOK_SECRET=replace-with-32-random-bytes
