diff --git a/src/hooks/useCheckoutStatus.ts b/src/hooks/useCheckoutStatus.ts
new file mode 100644
index 0000000..9be2f17
--- /dev/null
+++ b/src/hooks/useCheckoutStatus.ts
@@ -0,0 +1,26 @@
+import { useEffect, useState } from 'react';
+
+const CHECKOUT_ORIGIN = 'https://checkout.partner-pay.com';
+
+type CheckoutStatus = 'idle' | 'pending' | 'paid' | 'failed';
+
+const STATUSES: readonly CheckoutStatus[] = ['pending', 'paid', 'failed'];
+
+export function useCheckoutStatus(frame: HTMLIFrameElement | null): CheckoutStatus {
+  const [status, setStatus] = useState<CheckoutStatus>('idle');
+
+  useEffect(() => {
+    function onMessage(event: MessageEvent) {
+      if (event.origin !== CHECKOUT_ORIGIN) return;
+      if (!frame || event.source !== frame.contentWindow) return;
+      const next = event.data?.status;
+      if (STATUSES.includes(next)) setStatus(next);
+    }
+    window.addEventListener('message', onMessage);
+    return () => window.removeEventListener('message', onMessage);
+  }, [frame]);
+
+  return status;
+}
+
+export default useCheckoutStatus;
